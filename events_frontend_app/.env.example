# Do NOT commit .env with secrets. This file documents expected env vars.

# Backend base URL for API calls (preferred)
REACT_APP_API_BASE=http://localhost:8000

# Alternative backend URL (fallback if API_BASE is not set)
REACT_APP_BACKEND_URL=http://localhost:8000

# Frontend URL (optional; informational)
REACT_APP_FRONTEND_URL=http://localhost:3000

# Optional WebSocket base URL
REACT_APP_WS_URL=ws://localhost:8000

# Misc
REACT_APP_NODE_ENV=development
REACT_APP_PORT=3000
REACT_APP_ENABLE_SOURCE_MAPS=true
REACT_APP_NEXT_TELEMETRY_DISABLED=1
